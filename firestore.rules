rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function hasStaff() { return signedIn() && exists(staffPath()); }
    function role() { return isOwner() ? 'admin' : (hasStaff() ? get(staffPath()).data.role : 'none'); }
    function isStaff() { return isOwner() || (hasStaff() && get(staffPath()).data.get('disabled', false) != true); }
    // Per-section permission level: 0 none, 1 view, 2 add & edit, 3 full with delete.
    function legacyLvl(mod) { return role() == 'viewer' ? 1 : {'finance': 3, 'appointments': 3, 'reports': 1}.get(mod, 2); }
    function lvl(mod) {
      return isAdmin() ? 3
        : (get(staffPath()).data.get('perms', null) == null ? legacyLvl(mod) : get(staffPath()).data.perms.get(mod, 0));
    }
    function modOf(col) {
      return {'sales': 'sales', 'sreturns': 'sales', 'quotes': 'quotes', 'purchases': 'purchases', 'preturns': 'purchases',
              'porders': 'porders', 'customers': 'customers', 'suppliers': 'suppliers', 'products': 'products', 'pimages': 'products',
              'payments': 'finance', 'appointments': 'appointments', 'workorders': 'workorders'}.get(col, 'none');
    }
    // writes that other sections need (e.g. a sales invoice records its payment, creates its customer, marks the quote converted)
    function canWriteCol(col) {
      return lvl(modOf(col)) >= 2
        || (col in ['payments', 'customers', 'quotes', 'workorders'] && lvl('sales') >= 2)
        || (col in ['payments', 'suppliers', 'porders'] && lvl('purchases') >= 2)
        || (col == 'customers' && (lvl('quotes') >= 2 || lvl('workorders') >= 2 || lvl('appointments') >= 2))
        || (col == 'suppliers' && lvl('porders') >= 2)
        || (col in ['appointments', 'customers'] && lvl('workorders') >= 2)
        || (col == 'workorders' && lvl('appointments') >= 2);
    }
    function canWrite() { return isStaff() && role() in ['admin', 'staff']; }
    function isAdmin() { return isStaff() && role() == 'admin'; }
    function myEmail() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }

    // Ownership: the first signed-in user can claim it once.
    match /meta/owner {
      allow get: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Claude connector key (admins only; read by the Cloud Function with admin rights)
    match /meta/mcp {
      allow read, write: if isAdmin();
    }
    match /meta/settings {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Users: admin manages; an invited user with a verified email activates themself with the invited role.
    match /staff/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && isOwner() && request.resource.data.role == 'admin')
        || (signedIn() && request.auth.uid == uid
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/invites/$(myEmail()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(myEmail())).data.role
            && request.resource.data.get('perms', null) == get(/databases/$(database)/documents/invites/$(myEmail())).data.get('perms', null)
            && request.resource.data.get('disabled', false) == false);
      allow update, delete: if isAdmin();
    }
    match /invites/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && myEmail() == email && hasStaff());
    }

    // Join requests: a signed-up user with a verified email asks the admin for access.
    match /requests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true
        && request.resource.data.email == myEmail() && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'phone', 'at', 'status']);
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Shared stocktake in progress (one document: stocktake/current)
    match /stocktake/{id} {
      allow read: if isStaff() && lvl('products') >= 1;
      allow write: if isStaff() && lvl('products') >= 2;
    }

    // Activity log: staff append entries about themselves; nobody can change or delete them.
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Customer portal: readable only by exact secret link (no listing).
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff() && (lvl('sales') >= 2 || lvl('quotes') >= 2 || lvl('customers') >= 2 || lvl('finance') >= 2);
    }

    // Push notification devices: each user manages their own devices (Cloud Functions send the notifications).
    match /pushTokens/{id} {
      allow create, update: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow get, delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    // Test-notification requests (processed and deleted by a Cloud Function).
    match /notify/{id} {
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow read, update, delete: if false;
    }

    // Outgoing email queue (sent by the "Trigger Email from Firestore" extension).
    match /mail/{id} {
      allow create: if isStaff()
        && (lvl('sales') >= 2 || lvl('quotes') >= 2 || lvl('purchases') >= 2 || lvl('porders') >= 2 || lvl('finance') >= 2 || lvl('customers') >= 2)
        && request.resource.data.keys().hasOnly(['to', 'message', 'meta'])
        && request.resource.data.to is list && request.resource.data.to.size() <= 10
        && request.resource.data.meta.by == request.auth.uid;
      allow get: if canWrite();
      allow list, update, delete: if false;
    }

    // Business data
    match /{col}/{id} {
      allow read: if isStaff() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders'];
      allow create: if isStaff() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders']
        && canWriteCol(col);
      // numbered documents (INV-00012…) can't be silently replaced by a different new document with the same number
      allow update: if isStaff() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders']
        && canWriteCol(col)
        && (!(col in ['quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'workorders', 'porders'])
            || resource.data.get('createdAt', null) == null
            || request.resource.data.get('createdAt', null) == resource.data.createdAt);
      allow delete: if isStaff() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders']
        && (lvl(modOf(col)) >= 3 || (col == 'pimages' && lvl('products') >= 2));
    }
  }
}
