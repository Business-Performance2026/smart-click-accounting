rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function hasStaff() { return signedIn() && exists(staffPath()); }
    function role() { return isOwner() ? 'admin' : (hasStaff() ? get(staffPath()).data.role : 'none'); }
    function isStaff() { return isOwner() || hasStaff(); }
    function canWrite() { return isStaff() && role() in ['admin', 'staff']; }
    function isAdmin() { return isStaff() && role() == 'admin'; }
    function myEmail() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }

    // Ownership: the first signed-in user can claim it once.
    match /meta/owner {
      allow get: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Claude connector key (admins only; read by the Cloud Function with admin rights)
    match /meta/mcp {
      allow read, write: if isAdmin();
    }
    match /meta/settings {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Users: admin manages; an invited user with a verified email activates themself with the invited role.
    match /staff/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && isOwner() && request.resource.data.role == 'admin')
        || (signedIn() && request.auth.uid == uid
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/invites/$(myEmail()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(myEmail())).data.role);
      allow update, delete: if isAdmin();
    }
    match /invites/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && myEmail() == email && hasStaff());
    }

    // Activity log: staff append entries about themselves; nobody can change or delete them.
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Customer portal: readable only by exact secret link (no listing).
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if canWrite();
    }

    // Push notification devices: each user manages their own devices (Cloud Functions send the notifications).
    match /pushTokens/{id} {
      allow create, update: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow get, delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    // Test-notification requests (processed and deleted by a Cloud Function).
    match /notify/{id} {
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow read, update, delete: if false;
    }

    // Outgoing email queue (sent by the "Trigger Email from Firestore" extension).
    match /mail/{id} {
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(['to', 'message', 'meta'])
        && request.resource.data.to is list && request.resource.data.to.size() <= 10
        && request.resource.data.meta.by == request.auth.uid;
      allow get: if canWrite();
      allow list, update, delete: if false;
    }

    // Business data
    match /{col}/{id} {
      allow read: if isStaff() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders'];
      allow create, update: if canWrite() && col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders'];
      allow delete: if col in ['customers', 'suppliers', 'products', 'quotes', 'sales', 'purchases', 'payments', 'sreturns', 'preturns', 'appointments', 'workorders', 'pimages', 'porders']
        && (isAdmin() || (col in ['payments', 'appointments', 'pimages'] && canWrite()));
    }
  }
}
